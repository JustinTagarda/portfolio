    "source_file_name": "Resume - Justiniano Tagarda.pdf", "name": "JUSTINIANO TAGARDA", "title": "SENIOR .NET BACKEND & FULL-STACK DEVELOPER",
    "profile": "Senior .NET developer with extensive experience building and supporting production APIs, SQL-backed business systems, internal platforms, and customer portals. Backend-first in C#, .NET, ASP.NET, and SQL Server, with full-stack delivery experience using React, Next.js, and TypeScript. Skilled at translating business requirements into maintainable software and supporting it through deployment, troubleshooting, and ongoing operations.",
    "resume_profile": "Senior .NET backend and full-stack developer with 20+ years building and modernizing business-critical systems, production APIs, internal platforms, and released desktop, web, and cross-platform products. Hands-on across C#/.NET, SQL Server, React/Next.js, WPF, Flutter, deployment, and production support, with ownership from architecture through troubleshooting.",
    "resume_availability": "Open to full-time remote senior .NET/backend or full-stack opportunities.", "resume_portfolio_label": "Portfolio: published apps, production systems, and project case studies",
    "resume_skill_summary": ["Core Backend: C#, .NET 10, ASP.NET Core, ASP.NET Framework, REST APIs, API integrations, SQL Server, Entity Framework Core", "Web & Cloud: React 19, Next.js 16, TypeScript, Supabase, PostgreSQL, RLS/RPC, OAuth, JWT, RBAC, Vertex AI, Gemini", "Cross-platform & Desktop: Flutter, Dart, WPF, Kotlin, C++/WinRT, SQLite, MSIX", "Local AI & Media: ONNX Runtime, whisper.cpp, pyannote, OCR/TTS, RTSP/ONVIF, LibVLCSharp", "Delivery & Quality: IIS, Windows Server, Docker, Git, GitHub, GitHub Actions, Firebase Hosting, AI-assisted development, human-reviewed delivery, xUnit, Vitest"],
    "resume_education": [{ "degree_or_certificate": "BS Commerce major in Accounting", "institution": "Xavier University College", "location": "Cagayan de Oro City, Philippines", "start": "", "end": "" }],
